<?xml version="1.0" encoding="UTF-8"?>

<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- ===================================================== -->
    <!-- Vehicle Types for Indian Heterogeneous Traffic -->
    <!-- ===================================================== -->

    <!-- Standard Passenger Car -->
    <vType id="car"
           vClass="passenger"
           accel="2.8"
           decel="4.5"
           emergencyDecel="8.0"
           sigma="0.7"
           tau="0.8"
           length="4.5"
           minGap="1.0"
           maxSpeed="16.67"
           color="0,0,255"/>

    <!-- Motorcycle / Two Wheeler -->
    <vType id="bike"
           vClass="motorcycle"
           accel="4.5"
           decel="5.5"
           emergencyDecel="8.5"
           sigma="0.9"
           tau="0.5"
           length="2.0"
           minGap="0.3"
           maxSpeed="18.0"
           color="255,0,0"/>

    <!-- Auto Rickshaw -->
    <vType id="auto"
           vClass="taxi"
           accel="2.6"
           decel="4.0"
           emergencyDecel="7.0"
           sigma="0.8"
           tau="0.7"
           length="2.8"
           minGap="0.6"
           maxSpeed="13.9"
           color="255,215,0"/>

    <!-- City Bus -->
    <vType id="bus"
           vClass="bus"
           accel="1.3"
           decel="4.0"
           emergencyDecel="6.5"
           sigma="0.5"
           tau="1.1"
           length="12.0"
           minGap="2.5"
           maxSpeed="12.5"
           color="0,180,0"/>

</routes>